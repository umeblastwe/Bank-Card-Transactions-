	column 'Age Group' =
			
			SWITCH(
			    TRUE(),
			    credit_card_transactions[Age] <= 20, "≤ 20",
			    credit_card_transactions[Age] <= 30, "21-30",
			    credit_card_transactions[Age] <= 40, "31-40",
			    credit_card_transactions[Age] <= 50, "41-50",
			    credit_card_transactions[Age] <= 60, "51-60",
			    "60+"
			)
		lineageTag: 0d7aba2e-8fa5-4923-93e4-47b1b48d8bd2
